<?xml version="1.0" encoding="UTF-8"?>
<!-- The main menu (docs/menu_screens.md). The new menu engine's;
display.menu_engine = "classic" keeps the PC version's. Laid out as the PC
version's main menu: the title art, then the items, their words drawn as
text over a button frame lit by its focus outline while focused (vector
elements: ce/bitmaps.xml's main_menu/item_frame), no hints or button bar. -->
<screen name="main" back="quit">
	<title-art/>
	<list focus="campaign">
		<item id="training" label="VR TUTORIAL" backdrop="main_menu/item_frame" when="vr" do="open training"/>
		<item id="campaign" label="CAMPAIGN" backdrop="main_menu/item_frame" do="open campaign"/>
		<item id="multiplayer" label="MULTIPLAYER" backdrop="main_menu/item_frame" do="open multiplayer"/>
		<item id="settings" label="SETTINGS" backdrop="main_menu/item_frame" do="open settings"/>
		<item id="quit" label="QUIT" backdrop="main_menu/item_frame" do="quit"/>
	</list>
</screen>
