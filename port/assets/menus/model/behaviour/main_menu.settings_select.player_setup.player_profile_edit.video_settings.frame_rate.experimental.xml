<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.settings_select.player_setup.player_profile_edit.video_settings.frame_rate.experimental.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/frame_rate/experimental/experimental_screen" flags="pass_unhandled_to_focused_child pause_game">
		<on event="b" run="port settings page cancel" back="true"/>
		<on event="back" run="port settings page cancel" back="true"/>
		<on event="y" run="port settings search"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/frame_rate/experimental/options_menu" flags="pass_unhandled_to_focused_child up_down_tabs_children"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/frame_rate/experimental/button_bar" flags="pass_unhandled_to_focused_child left_right_tabs_items"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/frame_rate/experimental/button_defaults">
		<on event="a" run="port settings defaults"/>
		<on event="start" run="port settings defaults"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/frame_rate/experimental/button_ok">
		<on event="a" run="port settings keep" back="true"/>
		<on event="start" run="port settings keep" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/frame_rate/experimental/button_cancel">
		<on event="a" run="port settings page cancel" back="true"/>
		<on event="start" run="port settings page cancel" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/frame_rate/experimental/op_ray_traced_lighting" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/frame_rate/experimental/ray_traced_lighting_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
		<on event="a" run="port setting segment"/>
	</behaviour>
</model>
