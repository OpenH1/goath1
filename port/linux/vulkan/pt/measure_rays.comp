#version 460
// Path tracing's stage 0, "Measure" (docs/rt-plan/4-path-tracing.md): ray
// throughput against the ray-traced scene (xgpu_vulkan_pt_measure.c). Each
// pixel the occlusion's pre-pass found a surface at (its inputs: the
// normal, octahedral; the flags; the distance) casts rays_per_pixel rays
// from that point: mode 0 diffuse (cosine about the normal), the nearest hit,
// every candidate taken as opaque; mode 1 the same, the non-opaque
// candidates (the objects', the cutouts') confirmed in the loop; mode 2
// shadow rays (a random direction about the normal, the first hit ends it).
// Mask 3: the structure and the objects (not the first-person models nor
// the player's own body). Counted: the rays cast and their hits (so nothing is optimized away).
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1) uniform usampler2D inputs;
layout(set = 0, binding = 2) buffer Counts { uint counts[4]; };

layout(push_constant) uniform Pass
{
	vec4 camera[4];
	ivec4 corners;
	uvec4 parameters; // frame, rays a pixel, mode, 0
} pass;

const uint INPUT_PRESENT = 0x400u;

shared uint group_rays, group_hits;

uint hash(uint x)
{
	x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
	return x;
}

float random_unit(inout uint state)
{
	state = state * 747796405u + 2891336453u;
	return float(hash(state) >> 8) * (1.0 / 16777216.0);
}

vec3 octahedral(uint packed)
{
	vec2 e = vec2(float(int(packed << 16) >> 16), float(int(packed) >> 16)) / 32767.0;
	vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
	if (n.z < 0.0)
		n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
	return normalize(n);
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) + pass.corners.xy;
	uint rays = 0u, hits = 0u;

	if (gl_LocalInvocationIndex == 0u)
	{
		group_rays = 0u;
		group_hits = 0u;
	}
	barrier();
	if (pixel.x < pass.corners.z && pixel.y < pass.corners.w)
	{
		uvec4 texel = texelFetch(inputs, pixel, 0);

		if ((texel.y & INPUT_PRESENT) != 0u)
		{
			vec2 size = vec2(pass.corners.zw - pass.corners.xy);
			vec2 screen = (vec2(pixel - pass.corners.xy) + 0.5) / size * 2.0 - 1.0;
			vec3 view = normalize(pass.camera[1].xyz + screen.x * pass.camera[2].xyz + screen.y * pass.camera[3].xyz);
			float distance = uintBitsToFloat(texel.z);
			vec3 n = octahedral(texel.x);
			vec3 origin = pass.camera[0].xyz + view * distance + n * 0.01;
			vec3 t = normalize(abs(n.x) < 0.6 ? cross(n, vec3(1, 0, 0)) : cross(n, vec3(0, 1, 0)));
			vec3 b = cross(n, t);
			uint state = hash(uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + pass.parameters.x * 26699u);
			uint mode = pass.parameters.z;

			for (uint ray = 0u; ray < pass.parameters.y; ray++)
			{
				float u = random_unit(state), v = random_unit(state);
				float phi = 6.2831853 * v;
				vec3 direction;
				rayQueryEXT query;

				if (mode == 2u)
				{
					float z = u, r = sqrt(max(0.0, 1.0 - z * z));
					direction = r * cos(phi) * t + r * sin(phi) * b + z * n;
					rayQueryInitializeEXT(query, scene, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
						0x03u, origin, 0.001, direction, 1000.0);
				}
				else
				{
					float r = sqrt(u);
					direction = r * cos(phi) * t + r * sin(phi) * b + sqrt(1.0 - u) * n;
					rayQueryInitializeEXT(query, scene, mode == 0u ? gl_RayFlagsOpaqueEXT : gl_RayFlagsNoneEXT,
						0x03u, origin, 0.001, direction, 1000.0);
				}
				while (rayQueryProceedEXT(query))
				{
					if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionTriangleEXT)
						rayQueryConfirmIntersectionEXT(query);
				}
				rays++;
				if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT)
					hits++;
			}
		}
	}
	atomicAdd(group_rays, rays);
	atomicAdd(group_hits, hits);
	barrier();
	if (gl_LocalInvocationIndex == 0u)
	{
		atomicAdd(counts[0], group_rays);
		atomicAdd(counts[1], group_hits);
	}
}
