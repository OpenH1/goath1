@@ -130,6 +139,11 @@ static bool DisableDeckLizardMode(SDL_hid_device *dev)
     return true;
 }
 
+/* The keep-alive's period: the Steam Controller (2026) driver's
+   (SDL_hidapi_steam_triton.c, 3 seconds); Linux's hid-steam driver feeds
+   the Deck's every 5 seconds, so the firmware's timeout is longer. */
+#define STEAMDECK_LIZARD_WATCHDOG_MS 3000
+
 static bool FeedDeckLizardWatchdog(SDL_hid_device *dev)
 {
     int rc;
@@ -158,6 +172,47 @@ static bool FeedDeckLizardWatchdog(SDL_hid_device *dev)
     return true;
 }
 
+static int SDLCALL SteamDeckLizardWatchdogThread(void *data)
+{
+    SDL_DriverSteamDeck_Context *ctx = (SDL_DriverSteamDeck_Context *)data;
+
+    while (!SDL_WaitSemaphoreTimeout(ctx->watchdog_stop, STEAMDECK_LIZARD_WATCHDOG_MS)) {
+        FeedDeckLizardWatchdog(ctx->watchdog_dev);
+    }
+    return 0;
+}
+
+static void StopDeckLizardWatchdog(SDL_DriverSteamDeck_Context *ctx)
+{
+    if (ctx->watchdog_thread) {
+        SDL_SignalSemaphore(ctx->watchdog_stop);
+        SDL_WaitThread(ctx->watchdog_thread, NULL);
+        ctx->watchdog_thread = NULL;
+    }
+    if (ctx->watchdog_stop) {
+        SDL_DestroySemaphore(ctx->watchdog_stop);
+        ctx->watchdog_stop = NULL;
+    }
+    if (ctx->watchdog_dev) {
+        SDL_hid_close(ctx->watchdog_dev);
+        ctx->watchdog_dev = NULL;
+    }
+}
+
+static bool StartDeckLizardWatchdog(SDL_HIDAPI_Device *device, SDL_DriverSteamDeck_Context *ctx)
+{
+    ctx->watchdog_dev = SDL_hid_open_path(device->path);
+    ctx->watchdog_stop = SDL_CreateSemaphore(0);
+    if (ctx->watchdog_dev && ctx->watchdog_stop) {
+        ctx->watchdog_thread = SDL_CreateThread(SteamDeckLizardWatchdogThread, "SDLSteamDeckWatchdog", ctx);
+    }
+    if (!ctx->watchdog_thread) {
+        StopDeckLizardWatchdog(ctx);
+        return false;
+    }
+    return true;
+}
